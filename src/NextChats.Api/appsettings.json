{
  "ConnectionStrings": {
    "Default": "Data Source=data/nextchats.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "EncryptionKey": "Q2hhbmdlVGhpc0VuY3J5cHRpb25LZXlUb0FyYW5kb21CYXNlNjRTdHJpbmc=",
    "JwtKey": "9f8e7d6c5b4a39281706f5e4d3c2b1a09f8e7d6c5b4a39281706f5e4d3c2b1a0",
    "JwtIssuer": "next-chats",
    "JwtAudience": "next-chats-web",
    "JwtExpireMinutes": 30,
    "JwtRefreshExpireDays": 7,
    "ProceedOnInjection": true
  },
  "Policy": {
    "DangerousToolPatterns": [
      ".*(delete|drop|remove|truncate|purge|destroy).*",
      ".*(exec|shell|command|run_script|bash|powershell).*",
      ".*(send_|transfer|payment|charge|approve|publish|release|deploy).*",
      ".*(update_password|reset_password|revoke|ban|unban).*"
    ],
    "DenyToolPatterns": [],
    "AllowToolPatterns": [
      "mock\\..*"
    ],
    "ApprovalTimeoutSeconds": 120,
    "MaxReActSteps": 50,
    "MaxToolRetries": 2,
    "ToolRetryDelayMs": 300
  },
  "Context": {
    "CharsPerToken": 4,
    "CompressThreshold": 0.8,
    "CompressTarget": 0.5,
    "MinMessagesAfterTruncate": 4,
    "TruncateChunkMessages": 4
  },
  "BuiltinTool": {
    "HttpFetchAllowHosts": [
      "github.com",
      "raw.githubusercontent.com"
    ],
    "HttpFetchMaxBytes": 2000000,
    "HttpFetchMaxChars": 40000,
    "HttpFetchTimeoutSeconds": 12
  },
  "ToolTrace": {
    "MaxResultPreviewChars": 2000
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  }
}

