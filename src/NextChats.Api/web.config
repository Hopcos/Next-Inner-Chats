<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 托管配置模板。dotnet publish 会以本文件为基础，自动补全 aspNetCore 处理程序与进程参数。

  关键：必须移除 IIS 的 WebDAV 模块与处理程序。
  WebDAV 默认会接管 PUT / DELETE 等动词并直接返回 405（Method Not Allowed），
  请求到不了应用，表现为后台管理里“启停 / 编辑 / 删除”（PUT、DELETE 接口）全部 405，
  而 GET / POST 正常。移除后这些动词才会交给 ASP.NET Core 处理。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <remove name="OPTIONSVerbHandler" />
        <remove name="TRACEVerbHandler" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\NextChats.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
