# Copy to `.env` (same folder as docker-compose.yml) and fill in the values.
#   cp .env.example .env
#
# Generate secrets, e.g.:
#   openssl rand -base64 48        # NEXTCHATS_JWT_KEY
#   openssl rand -base64 32        # NEXTCHATS_ENCRYPTION_KEY

# REQUIRED. Signs login tokens (JWT). Changing it logs everybody out.
NEXTCHATS_JWT_KEY=

# REQUIRED. Encrypts stored secrets (LLM / MCP API keys) in the database.
# Keep it stable: after changing it, previously stored secrets can no longer be decrypted.
NEXTCHATS_ENCRYPTION_KEY=

# Host port that serves the web UI + API (container always listens on 8080).
NEXTCHATS_PORT=8080

# Only needed if the UI is served from a different origin than the API (e.g. a dev server).
# Same-origin deployments (the default) do not need CORS at all.
# NEXTCHATS_CORS_ORIGIN=http://localhost:5173

# Host directory made available to the agent as workspace root (optional, see docker-compose.yml).
# NEXTCHATS_WORKSPACES=./workspaces
